<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/journal_surface_muted" />
            <stroke
                android:width="1dp"
                android:color="@color/journal_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/journal_accent_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/journal_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/journal_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/journal_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
